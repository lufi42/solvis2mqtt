#! /bin/sh
test -f /opt/solvis/solvis2mqtt/solvis2mqtt.jar || exit 0
javaPath="/usr/bin/java"
serverJarPath="/opt/solvis/solvis2mqtt/solvis2mqtt.jar"
writeablePath="/media/data/fhem/SolvisXml"
case "$1" in
    start)
        echo "Starte solvis2mqtt"
        $javaPath -jar $serverJarPath
        ;;
    stop)
        echo "Stoppe solvis2mqtt"
        $javaPath -jar $serverJarPath --server-terminate
        ;;
    restart)
        echo "Restart solvis2mqtt"
        $javaPath -jar $serverJarPath --server-terminate
        $javaPath -jar $serverJarPath
        ;;
    *)
        echo "usage:  MATH
 $0 start | stop | restart"
        exit 1
        ;;
esac$